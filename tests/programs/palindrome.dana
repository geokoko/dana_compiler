def main
    def check_pal is byte: s as byte[]
        var res is byte
        var i l is int

        l := strlen(s)
        i := 0
        res := true

        loop:
            if i = l / 2: break
            elif not s[i] = s[l-i-1]:
                res := false
                break
            else:
                i := i + 1
        return: res

    var is_pal is byte
    var count is int
    var tests is byte [5][6]

    strcpy: tests[0], "abbaa"
    strcpy: tests[1], "baada"
    strcpy: tests[2], "lolol"
    strcpy: tests[3], "abcba"
    strcpy: tests[4], "hello"

    count := 0

    loop:
        if count > 4:
            break

        is_pal := check_pal(tests[count])

        if is_pal = true:
            writeString: tests[count]
            writeString: " ... is palindrome\n"
        else:
            writeString: tests[count]
            writeString: " ... is not palindrome\n"

        count := count + 1
